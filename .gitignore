.env
# Ignore everything inside these folders
upload/items/*
upload/sections/*

# Explicitly allow the .gitkeep files so the folders are tracked
!upload/items/.gitkeep
!upload/sections/.gitkeep


# --- Python generated files ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Distribution / packaging ---
dist/
build/
*.egg-info/
*.egg
*.whl

# --- Environment variables (Sensitive) ---
.env
.env.local
.env.*.local
*.env

# --- IDE and Editor settings ---
.vscode/
.idea/
.DS_Store  # macOS specific

# --- Testing and Coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Database files ---
*.db
*.sqlite3