# --- Custom Project Folders ---
# Ignore everything inside these folders, but keep the directories
upload/items/*
upload/sections/*
!upload/items/.gitkeep
!upload/sections/.gitkeep

# --- Python generated files ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Distribution / packaging ---
dist/
build/
*.egg-info/
*.egg
*.whl

# --- Environment variables (Sensitive) ---
.env
.env.local
.env.*.local
*.env

# --- IDE and Editor settings ---
.vscode/
.idea/
.DS_Store

# --- Testing and Coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# --- Database files ---
*.db
*.sqlite3